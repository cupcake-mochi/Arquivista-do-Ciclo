# Nunca publique o .env real. Configure uma aplicação Discord separada dos Guias.
DISCORD_TOKEN=
# Opcional: servidor de testes. Com ele, os comandos / aparecem na hora e só nele.
# Vazio = modo público, comandos em todos os servidores.
DISCORD_DEV_GUILD_ID=
# Cargos de staff e canais ficam no /configurar de cada servidor.
PERSONA_NAME=Amiya
CONFIGURAR_AVATAR=false
POLL_SECONDS=90
TIMEZONE=America/Sao_Paulo
# DATABASE_PATH=dados/arquivista.sqlite3
# Opcional: chave mestra (32+ caracteres) que cifra a chave de cada planilha conectada.
# Sem ela, a cifra usa o token; trocar o token obriga a reconectar as planilhas.
# AC_MASTER_KEY=
